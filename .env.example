# copy to .env and fill in. `openssl rand -hex 24` makes a good token.
BRIGHTHERMES_TOKEN=
# June's API_SERVER_KEY (from the hermes container's /opt/data/.env)
HERMES_API_KEY=
HERMES_MODEL=
HA_URL=http://192.168.68.59:8123
HA_TOKEN=
HA_ENTITY=light.living_room
HA_LABEL=Living room
# Other Hermes agents beside June. A second profile on June's gateway once multiplex_profiles is on,
# or a Hermes on another box. api_key may be omitted for a profile on June's own gateway.
BOTS=[{"id":"work","name":"Work","url":"http://172.17.0.1:8642/p/work"}]
